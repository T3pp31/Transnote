        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Download" }
        }
      }
    },
    "後で" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Later" }
        }
      }
    },
    "バージョン %@ が利用可能です（現在: %@）。\nダウンロード後、DMG 内の「インストール.command」を実行してください。\n旧バージョンは自動的に置き換えられます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Version %@ is available (current: %@).\nAfter downloading, run “Install.command” in the DMG.\nThe previous version will be replaced automatically." }
        }
      }
    },
