      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Model Not Downloaded" }
        }
      }
    },
    "未対応のファイル形式です: %@。wav / mp3 / m4a / flac に対応しています。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Unsupported file format: %@. Supported formats: wav, mp3, m4a, and flac." }
        }
      }
    },
    "選択したファイルが見つかりません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The selected file could not be found." }
        }
      }
    },
    "ファイルへのアクセスが拒否されました。もう一度ファイルを選択してください。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Access to the file was denied. Please select the file again." }
        }
      }
    },
    "文字起こしをキャンセルしました。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Transcription was cancelled." }
        }
      }
    },
    "エクスポートに失敗しました: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Export failed: %@" }
        }
