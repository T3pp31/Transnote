      }
    },
    "処理中です" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Operation in progress" }
        }
      }
    },
    "文字起こし結果をコピーしました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Transcription copied" }
        }
      }
    },
    "保存しました: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Saved: %@" }
