    "未対応のファイル形式です: %@。wav / mp3 / m4a / flac に対応しています。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Unsupported file format: %@. Supported formats: wav, mp3, m4a, and flac." }
        }
      }
    },
    "選択したファイルが見つかりません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The selected file could not be found." }
        }
      }
