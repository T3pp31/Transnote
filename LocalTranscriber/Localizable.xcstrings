      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The app configuration is invalid." }
        }
      }
    },
    "保存済みファイルへのアクセスを復元できませんでした。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Access to the saved file could not be restored." }
        }
      }
    },
    "モデル「%@」がダウンロードされていません。ツールバーの「ダウンロード」ボタンからダウンロードしてください。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Model “%@” has not been downloaded. Download it using the Download button in the toolbar." }
