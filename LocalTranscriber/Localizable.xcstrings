      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%d percent complete" }
        }
      }
    },
    "%@、%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%@, %@" }
        }
      }
    },
    "%@でエクスポートしました" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Exported as %@" }
        }
      }
    },
    "文字起こし処理中です" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Transcription is in progress" }
        }
      }
    },
    "文字起こしを開始（⌘↩）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Start transcription (⌘↩)" }
        }
      }
    },
    "音声ファイルを選択してください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Select an audio file" }
        }
      }
    },
    "モデルを選択してください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Select a model" }
